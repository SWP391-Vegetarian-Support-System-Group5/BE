# Copy this file to .env and replace the placeholders. Do not commit .env.
Gemini__ApiKey="replace-with-your-gemini-api-key"
Gemini__VideoFallbackModel="gemini-3.1-flash-lite"
Gemini__VideoGenerationTimeoutSeconds=90
SendGrid__ApiKey="replace-with-your-sendgrid-api-key"
Cloudinary__CloudName="replace-with-your-cloud-name"
Cloudinary__ApiKey="replace-with-your-cloudinary-api-key"
Cloudinary__ApiSecret="replace-with-your-cloudinary-api-secret"
Cloudinary__VideoFolder="veggiemate/videos"
Cloudinary__ImageFolder="veggiemate/images"
